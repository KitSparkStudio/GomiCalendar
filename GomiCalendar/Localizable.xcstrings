    "paywall_legal_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GomiCalendar Pro is a one-time non-consumable purchase (¥480). Payment is charged to your Apple ID at confirmation. This is not an auto-renewing subscription. Use Restore Purchases if you reinstall or change devices."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GomiCalendar Pro は ¥480 の買い切り（非消耗型）です。確認時に Apple ID へ課金されます。自動更新サブスクリプションではありません。再インストールや機種変更時は「購入を復元」をご利用ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GomiCalendar Pro는 ¥480 일회성 비소모성 구매입니다. 확인 시 Apple ID로 결제됩니다. 자동 갱신 구독이 아닙니다. 재설치·기기 변경 시 구입 항목 복원을 사용하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GomiCalendar Pro là mua một lần không tiêu hao (¥480). Thanh toán trừ Apple ID khi xác nhận. Không phải đăng ký tự gia hạn. Dùng Khôi phục giao dịch khi cài lại/đổi máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GomiCalendar Pro 为 ¥480 一次性非消耗型买断。确认购买后将向 Apple ID 收费。非自动续费订阅。重装或换机请使用「恢复购买」。"
          }
        }
      }
    },
